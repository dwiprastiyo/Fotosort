{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions required by the FotoSort desktop window.",
  "windows": ["main"],
  "permissions": [
    "dialog:allow-open",
    "fs:allow-read",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/**/*",
        "$DOCUMENT/**/*",
        "$DOWNLOAD/**/*",
        "$DESKTOP/**/*",
        "$PICTURE/**/*",
        "/Volumes/**/*"
      ]
    },
    "shell:allow-open"
  ]
}
