{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "FotoSort",
  "version": "1.0.0",
  "identifier": "com.fotosort.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FotoSort — Rapid Photo Culling",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "maxWidth": 2560,
        "maxHeight": 1440,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "skipTaskbar": false,
        "visible": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*",
          "$PICTURE/**/*",
          "$DOCUMENT/**/*",
          "$DOWNLOAD/**/*",
          "$DESKTOP/**/*",
          "/Volumes/**/*"
        ]
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost file: https: data:; media-src 'self' asset: http://asset.localhost https://asset.localhost file:;"
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
